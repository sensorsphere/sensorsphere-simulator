# MQTT broker used by the simulator.
# SIMULATOR_MQTT_HOST=100.64.0.9
# SIMULATOR_MQTT_PORT=1883
# SIMULATOR_MQTT_USERNAME=
# SIMULATOR_MQTT_PASSWORD=

# Default MQTT topic prefix used by Basic injection.
# It can be overridden independently for each Basic injection sensor in the UI.
# MQTT_TOPIC_PREFIX=sensors/ble_gateway/sensor
