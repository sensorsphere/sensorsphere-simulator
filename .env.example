# ==============================================================================
# SensorSphere Sensor Simulator - Environment configuration
# ==============================================================================

# -----------------------------------------------------------------------------
# Application instance
# -----------------------------------------------------------------------------

# Friendly name used to identify this Simulator instance in the UI and logs.
# Useful when running multiple simulator instances.
# Default: DEV
#APP_INSTANCE_NAME=DEV

# -----------------------------------------------------------------------------
# Web / nginx
# -----------------------------------------------------------------------------

# Host address on which the web interface is published.
#
# Default:
# WEB_BIND_ADDRESS=0.0.0.0


# Web port published on the Docker host.
#
# Each SensorSphere instance on the same host MUST use a different port.
#
# Default:
# WEB_PORT=8090

# ------------------------------------------------------------------------------
# MQTT connection
# ------------------------------------------------------------------------------

# MQTT broker hostname or IP address.
# Default: 100.64.0.9
#
# Examples:
#   SIMULATOR_MQTT_HOST=192.168.1.50
#   SIMULATOR_MQTT_HOST=100.64.0.9
#   SIMULATOR_MQTT_HOST=mqtt.example.local
#SIMULATOR_MQTT_HOST=192.168.0.5

# MQTT broker TCP port.
# Default: 1883
#SIMULATOR_MQTT_PORT=1883

# MQTT username.
# Leave empty if authentication is disabled on the broker.
#SIMULATOR_MQTT_USERNAME=

# MQTT password.
# Leave empty if authentication is disabled on the broker.
#SIMULATOR_MQTT_PASSWORD=

# Base MQTT topic used by the simulator when publishing sensor values.
# Default: sensors/ble_gateway/sensor
#SIMULATOR_MQTT_TOPIC_PREFIX=sensors/ble_gateway/ble-gateway-01/sensor
