+
+/* SIM-003 status/button colors */
+.sensor-status{
+  display:inline-block;
+  padding:3px 8px;
+  border-radius:999px;
+  font-size:11px;
+  font-weight:800;
+  line-height:1.2;
+}
+.sensor-status.running{
+  background:#dcfce7;
+  color:#166534;
+}
+.sensor-status.stopped{
+  background:#fee2e2;
+  color:#991b1b;
+}
+.btn-start{
+  background:#16a34a;
+  border-color:#16a34a;
+  color:#fff;
+}
+.btn-start:hover{
+  background:#15803d;
+}
+.btn-stop{
+  background:#dc2626;
+  border-color:#dc2626;
+  color:#fff;
+}
+.btn-stop:hover{
+  background:#b91c1c;
+}
+.btn-publish{
+  background:#2563eb;
+  border-color:#2563eb;
+  color:#fff;
+}
+.btn-publish:hover{
+  background:#1d4ed8;
+}
+
+/* SIM-003 publication log filters */
+.log-filters{
+  display:flex;
+  align-items:flex-end;
+  gap:10px;
+  flex-wrap:wrap;
+  padding:12px 16px;
+  border-bottom:1px solid #eee;
+  background:#fafafa;
+}
+.log-filters label{
+  display:flex;
+  flex-direction:column;
+  gap:4px;
+  font-size:12px;
+  color:#4b5563;
+}
+.log-filters select{
+  min-width:140px;
+}
+.log-count{
+  margin-left:auto;
+  padding-bottom:8px;
+  color:#6b7280;
+  font-size:12px;
+  font-weight:600;
+}
+.log-status{
+  display:inline-block;
+  padding:3px 7px;
+  border-radius:999px;
+  font-size:11px;
+  font-weight:800;
+}
+.status-ok{
+  background:#dcfce7;
+  color:#166534;
+}
+.status-info{
+  background:#dbeafe;
+  color:#1d4ed8;
+}
+.status-error{
+  background:#fee2e2;
+  color:#991b1b;
+}
+@media(max-width:750px){
+  .log-filters label{
+    flex:1 1 140px;
+  }
+  .log-filters select{
+    width:100%;
+    min-width:0;
+  }
+  .log-count{
+    width:100%;
+    margin-left:0;
+  }
+}
